{
  "name": "coh3-stats-desktop-app",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "repository": {
    "url": "https://github.com/cohstats/coh3-stats-desktop-app"
  },
  "engines": {
    "node": ">=22.22.1",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fix": "prettier --write src",
    "lint:prettier": "prettier --check src",
    "tauri": "tauri",
    "tauri:build:msstore": "dotenv -e .env -- cross-env VITE_DISABLE_UPDATER=true tauri build --config src-tauri/tauri.microsoftstore.conf.json",
    "tauri:build:linux": "dotenv -e .env -- cross-env VITE_DISABLE_UPDATER=true tauri build --config src-tauri/tauri.linux.conf.json",
    "prepare": "husky",
    "test:e2e": "wdio run wdio.conf.cjs",
    "test:e2e:obs": "yarn wdio run wdio.conf.cjs --spec test/specs/obs-overlay.e2e.js",
    "test:be": "cd src-tauri && cargo test --package coh3-stats-desktop-app --lib",
    "reinstall": "rm -rf node_modules && rm -fr dist && rm -fr src-tauri/target && rm -f src-tauri/Cargo.lock && yarn install && cd src-tauri && cargo update",
    "tauri:windows:build": "tauri-windows-bundle build"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,yml,css}": [
      "prettier --log-level warn --write"
    ],
    "*.md": [
      "prettier --log-level warn --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@mantine/notifications": "9.8.2",
    "@sentry/react": "11.20.0",
    "@tabler/icons-react": "3.53.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-cli": "2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-http": "2.9.0",
    "@tauri-apps/plugin-log": "2.10.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-shell": "2.6.0",
    "@tauri-apps/plugin-store": "2.5.1",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "@types/lodash": "4.17.28",
    "clsx": "2.1.1",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "mantine-datatable": "9.8.4",
    "mixpanel-browser": "2.86.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "tauri-plugin-fs-watch-api": "https://github.com/tauri-apps/tauri-plugin-fs-watch"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.2.0",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wdio/cli": "^7",
    "@wdio/local-runner": "^7",
    "@wdio/mocha-framework": "^7",
    "@wdio/spec-reporter": "^7",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "postcss": "8.5.34",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
